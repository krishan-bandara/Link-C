# Copy to .env (Docker) or .env.local (local development). Never commit the real file.
# On the VM run: chmod 600 .env

# Supabase project URL (public). Baked into the browser bundle at build time.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase publishable key, sb_publishable_... (public by design). Also baked in at build time.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# Supabase SECRET key, sb_secret_... (Project Settings > API keys). Server only, bypasses RLS. Never share.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# Public address of the app, no trailing slash. Used for invite and password-reset links and Supabase redirects.
APP_URL=https://link-c.innoforge.dpdns.org

# 32 random bytes, base64. Encrypts files, phone numbers and SMS credentials. Generate: node scripts/gen-secrets.mjs
# Keep an offline copy: losing it makes all stored media unreadable.
MASTER_KEY=
# 32+ random bytes, base64. Signs short-lived snap links. Generate: node scripts/gen-secrets.mjs
SIGNING_KEY=

# Where normal media is stored: local (VM disk, fine for development) or b2 (Backblaze B2).
STORAGE_DRIVER=local
# Backblaze B2 S3 endpoint, e.g. https://s3.us-west-004.backblazeb2.com (only when STORAGE_DRIVER=b2)
B2_ENDPOINT=
# Region part of the endpoint, e.g. us-west-004
B2_REGION=
# Name of the private bucket
B2_BUCKET=
# Application key ID (bucket-scoped key, not the master key)
B2_KEY_ID=
# Application key secret
B2_APP_KEY=

# Folder for snaps and temporary uploads. Inside Docker this is the ./data volume.
DATA_DIR=/data

# LiveKit Cloud project (voice and video calls): wss://your-project.livekit.cloud
LIVEKIT_URL=
# LiveKit API key
LIVEKIT_API_KEY=
# LiveKit API secret
LIVEKIT_API_SECRET=

# Time zone for SMS quiet hours and the monthly SMS cap
TZ=Asia/Colombo

# Web push notifications. Generate a pair with: npx web-push generate-vapid-keys
# (keep the private key secret; changing the pair makes every phone subscribe again)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
